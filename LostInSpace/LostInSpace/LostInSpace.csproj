<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DEV: .NET MAUI single project. Targets: Android + iOS only.
    Bump ApplicationDisplayVersion / ApplicationId for store releases; add MauiImage/MauiAsset for art.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>LostInSpace</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Lost in Space</ApplicationTitle>
    <ApplicationId>com.rorhoff.lostinspace</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0c0f14" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0c0f14" BaseSize="128,128" />
  </ItemGroup>

</Project>
