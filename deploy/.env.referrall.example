# Copy to /home/ubuntu/website-referrall/.env.referrall on EC2, then fill in real values.
# Never commit the concrete file — .gitignore already excludes .env*.
#
# This is the PROD env for referr-all.com. It backs the webapi-referrall systemd service
# (port 8002), which runs the app in SERVICE_MODE=referrall: only the Referr-All router +
# the Referr-All SPA served at "/".
#
#   nginx (referr-all.com) -> 127.0.0.1:8002 -> uvicorn main:app  (EnvironmentFile=this file)
#
# Confirm the right service answered by hitting https://referr-all.com/which-app — it prints
# APP_ENV, SERVICE_MODE, and the ENV_FILE in use.

# --- App ---
APP_ENV=production
SERVICE_MODE=referrall

# systemd's EnvironmentFile already populates os.environ; ENV_FILE is mainly for running
# uvicorn directly. The service unit also sets this.
# ENV_FILE=/home/ubuntu/website-referrall/.env.referrall

# Comma-separated origins (required for httpOnly cookies; cannot be *). Apex only — nginx
# 301s www -> apex before the request reaches the app.
CORS_ORIGINS=https://referr-all.com

# 1 in production: Cloudflare/nginx terminate TLS, so the session cookie must be Secure.
SESSION_COOKIE_SECURE=1

# --- Public URLs (used for email verification + password reset links) ---
# Referr-All is served at the domain root here (not under /referr-all), so the public base
# is the bare origin. _api_base() derives <origin>/api/referr-all and _app_base() uses the
# app origin for reset links (https://referr-all.com/?reset_token=...).
REFERR_ALL_PUBLIC_URL=https://referr-all.com
REFERR_ALL_APP_URL=https://referr-all.com

# --- PostgreSQL (dedicated prod database; starts empty) ---
# Use a SEPARATE database name from dev so referr-all.com prod data is isolated from
# rorhoff.com/referr-all staging. Tables are auto-created on first startup
# (Base.metadata.create_all in the app lifespan) — no migration scripts needed for a
# fresh DB. Password with special chars must be URL-encoded.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/ReferrAll_Prod

# --- Image storage (Cloudflare R2 / S3) for avatars, resumes, etc. ---
# All four S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_PUBLIC_BASE_URL must be
# set to enable uploads; otherwise the SPA falls back to inline base64.
# S3_BUCKET=referr-all-prod
# S3_ACCESS_KEY_ID=<r2 token id>
# S3_SECRET_ACCESS_KEY=<r2 token secret>
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://images.referr-all.com
# S3_KEY_PREFIX=prod/

# --- Email (Cloudflare Email Sending API) ---
# _send_email() POSTs to the Cloudflare Email Service REST API. Requires a token with the
# "Email Sending: Edit" permission and referr-all.com onboarded under
# Cloudflare -> Compute -> Email Service -> Email Sending. Without these, email is a logged
# no-op (verification/reset links still appear in the service logs).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SMTP_FROM=noreply@referr-all.com

# --- Stripe (Referr-All premium) ---
# Use LIVE keys for the public site once the flow is validated with test keys.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...      # Stripe -> Developers -> Webhooks -> referr-all.com endpoint
# Public domain Stripe redirects back to after Checkout. No trailing slash.
# STRIPE_PUBLIC_BASE_URL=https://referr-all.com
