; systemd unit for the PROD classifieds-only FastAPI service.
; Installs to: /etc/systemd/system/webapi-prod.service
; Loads:       /home/ubuntu/Website/.env.prod  (DATABASE_URL=...Classifieds_Prod, APP_ENV=production,
;                                               SERVICE_MODE=classifieds, S3_* set, CORS_ORIGINS=https://t1classifieds.com,...)
; Listens on:  127.0.0.1:8001   (nginx for t1classifieds.com proxies to this, behind Cloudflare)
; Reload:      sudo systemctl daemon-reload && sudo systemctl restart webapi-prod

[Unit]
Description=WebAPI (production, classifieds only) for t1classifieds.com
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Website
EnvironmentFile=/home/ubuntu/Website/.env.prod
Environment=PYTHONUNBUFFERED=1
Environment=ENV_FILE=/home/ubuntu/Website/.env.prod
ExecStart=/home/ubuntu/Website/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
