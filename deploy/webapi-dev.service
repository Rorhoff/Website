; systemd unit for the DEV FastAPI service.
; Installs to: /etc/systemd/system/webapi-dev.service
; Loads:       /home/ubuntu/Website/.env.dev   (DATABASE_URL=...RoryPortfolio, APP_ENV=development)
; Listens on:  127.0.0.1:8000   (nginx for rorhoff.com proxies to this)
; Reload:      sudo systemctl daemon-reload && sudo systemctl restart webapi-dev

[Unit]
Description=WebAPI (development) for rorhoff.com
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Website
EnvironmentFile=/home/ubuntu/Website/.env.dev
Environment=PYTHONUNBUFFERED=1
Environment=ENV_FILE=/home/ubuntu/Website/.env.dev
ExecStart=/home/ubuntu/Website/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
