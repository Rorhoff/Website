# Copy to .env in the same folder as main.py, then fill in. Never commit .env.
#
# Production (example EC2 deploy):
#   File path:  /home/ubuntu/Website/.env
#   systemd, e.g. in /etc/systemd/system/yourapp.service:
#     WorkingDirectory=/home/ubuntu/Website
#     EnvironmentFile=/home/ubuntu/Website/.env
#   The app also loads this file via path next to main.py; keep paths aligned.

# --- App ---
APP_ENV=development
# APP_ENV=production

# Comma-separated origins (required for httpOnly cookies; cannot be *)
# With nginx SSL, use only https for public origins, e.g.:
# CORS_ORIGINS=https://rorhoff.com,https://www.rorhoff.com,http://127.0.0.1:8000,http://localhost:8000

# Set to 1 when the site is served over HTTPS (secure session cookie; required in production with SSL)
SESSION_COOKIE_SECURE=0

# --- PostgreSQL ---
# Single URL (recommended). Password with special chars must be URL-encoded.
#
# Format:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
#
# Examples:
#   Local:     postgresql+psycopg://myuser:mypass@localhost:5432/mydb
#   With SSL:  postgresql+psycopg://user:pass@host:5432/db?sslmode=require
#
# Many hosts give a "postgres://..." or "postgresql://..." string — that works too;
# the app normalizes it to use the psycopg driver.
#
# If DATABASE_URL is unset, the app runs in memory-only mode (no DB sessions).

# --- API (Postman / X-API-Key + X-API-Secret) ---
# Optional. If set, the app uses this pair on first run (and in memory-only mode) instead
# of generating random values. A random secret is not generated when API_SECRET is set.
# Secrets longer than 72 UTF-8 bytes are truncated to fit bcrypt.
# API_KEY=your_public_key
# API_SECRET=your_shared_secret

# --- AIRevolution (Claude) — optional; Support agent uses this for full AI replies ---
# Get a key: https://console.anthropic.com/ — billing is on the account that owns the key.
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
