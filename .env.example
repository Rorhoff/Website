# Copy to .env (local dev) or .env.dev / .env.prod (EC2 dual-service deploy), then fill in.
# Never commit any concrete env file — .gitignore already excludes them.
#
# Two-environment deploy (same EC2 box, two systemd services):
#   /etc/systemd/system/webapi-dev.service   →  EnvironmentFile=/home/ubuntu/Website/.env.dev
#       ExecStart=.../uvicorn main:app --host 127.0.0.1 --port 8000
#   /etc/systemd/system/webapi-prod.service  →  EnvironmentFile=/home/ubuntu/Website/.env.prod
#       ExecStart=.../uvicorn main:app --host 127.0.0.1 --port 8001
#   nginx routes by Host header:
#       rorhoff.com          → 127.0.0.1:8000  (dev)
#       t1classifieds.com    → 127.0.0.1:8001  (prod, behind Cloudflare)
#
# Verify the right service answered a request by hitting /which-app — it prints APP_ENV
# and the ENV_FILE in use.

# --- App ---
APP_ENV=development
# APP_ENV=production

# Optional: explicit path to the env file main.py should load. systemd's EnvironmentFile
# already populates os.environ before Python starts, so this is mainly for running uvicorn
# directly (e.g. `ENV_FILE=.env.prod python -m uvicorn main:app`).
# ENV_FILE=/home/ubuntu/Website/.env.prod

# Comma-separated origins (required for httpOnly cookies; cannot be *).
# Dev:   CORS_ORIGINS=https://rorhoff.com,https://www.rorhoff.com,http://127.0.0.1:8000,http://localhost:8000
# Prod:  CORS_ORIGINS=https://t1classifieds.com,https://www.t1classifieds.com
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Set to 1 in production (Cloudflare/nginx terminate TLS so requests are HTTPS at the edge).
SESSION_COOKIE_SECURE=0

# --- PostgreSQL ---
# Single URL (recommended). Password with special chars must be URL-encoded.
#
# Format:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
#
# Use a SEPARATE database name for prod (same RDS instance is fine):
#   Dev:   ...:5432/RoryPortfolio
#   Prod:  ...:5432/Classifieds_Prod
#
# Many hosts give a "postgres://..." or "postgresql://..." string — that works too;
# the app normalizes it to use the psycopg driver.
#
# If DATABASE_URL is unset, the app runs in memory-only mode (no DB sessions).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Image storage (Cloudflare R2 recommended; AWS S3 also works — same env vars) ---
# All four S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_PUBLIC_BASE_URL must be
# set to enable uploads. If any are missing, /api/classifieds/uploads returns 503 and the
# SPA silently falls back to inline base64 (so dev still works without a bucket).
#
# Cloudflare R2 example:
#   S3_BUCKET=t1classifieds-prod
#   S3_ACCESS_KEY_ID=<r2 token id>
#   S3_SECRET_ACCESS_KEY=<r2 token secret>
#   S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_BASE_URL=https://images.t1classifieds.com   # custom domain on the bucket
#   S3_KEY_PREFIX=prod/                                   # use 'dev/' in .env.dev
#
# AWS S3 example:
#   S3_BUCKET=t1classifieds-prod
#   S3_ACCESS_KEY_ID=<iam access key>
#   S3_SECRET_ACCESS_KEY=<iam secret>
#   # leave S3_ENDPOINT_URL unset for AWS
#   S3_REGION=us-west-1
#   S3_PUBLIC_BASE_URL=https://dxxxxx.cloudfront.net      # CloudFront distribution
#   S3_KEY_PREFIX=prod/

# --- API (Postman / X-API-Key + X-API-Secret) ---
# Optional. If set, the app uses this pair on first run (and in memory-only mode) instead
# of generating random values. Use DIFFERENT pairs for dev vs prod so credentials don't
# cross environments. Secrets longer than 72 UTF-8 bytes are truncated to fit bcrypt.
# API_KEY=your_public_key
# API_SECRET=your_shared_secret

# --- Stripe (Classifieds gold + Referr-All featured posts) ---
# Dashboard: https://dashboard.stripe.com/test/apikeys
# All of STRIPE_SECRET_KEY, a webhook secret, and STRIPE_PUBLIC_BASE_URL must be set;
# otherwise checkout returns 503 and the SPA disables "Get Featured" / "Boost to Gold".
# Use TEST keys (pk_test_/sk_test_) on dev until the flow is validated end-to-end.
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PUBLIC_BASE_URL=https://rorhoff.com   # dev; no trailing slash
#
# Webhook secrets (create endpoints in Stripe → Developers → Webhooks):
#   Referr-All:  https://rorhoff.com/api/referr-all/premium/webhook  → checkout.session.completed
#   Classifieds: https://rorhoff.com/api/classifieds/gold/webhook    → checkout.session.completed
# REFERR_ALL_STRIPE_WEBHOOK_SECRET=whsec_...   # Referr-All (preferred on dev)
# STRIPE_WEBHOOK_SECRET=whsec_...              # Classifieds gold (or shared secret)
#
# On EC2 dev, run once interactively:  bash deploy/set-stripe-dev.sh

# --- AIRevolution (Claude) — optional; Support agent uses this for full AI replies ---
# Get a key: https://console.anthropic.com/ — billing is on the account that owns the key.
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- LDBG (landscape design board generator — Next.js on port 3002) ---
# Python sidecars (watercolor, geo ingest). Same venv as the main webapi service on EC2.
# LDBG_PYTHON=/home/ubuntu/app/venv/bin/python
