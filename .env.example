# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
# production: do not print API secrets to stderr on startup
# APP_ENV=production

# Comma-separated origins for browser + cookies (required when using session cookies; cannot be *)
# CORS_ORIGINS=https://rorhoff.com,https://www.rorhoff.com,http://127.0.0.1:8000,http://localhost:8000

# Set 1 in production behind HTTPS
SESSION_COOKIE_SECURE=0

# --- MySQL (HostGator / cPanel) ---
# Example (adjust user/host; HostGator often uses localhost from the app on the same server):
# DATABASE_URL=mysql+pymysql://cpaneluser_dbuser:YOUR_PASSWORD@localhost:3306/cpaneluser_API_DB

# If you do not set DATABASE_URL, the app runs in memory-only dev mode (no DB sessions).
